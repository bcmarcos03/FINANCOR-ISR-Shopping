{
    "name": "shopping-app",
    "version": "0.0.1",
    "private": true,
    "description": "Shopping App",
    "keywords": [
        "ui5",
        "openui5",
        "sapui5"
    ],
    "main": "webapp/index.html",
    "dependencies": {
        "@ericblade/quagga2": "^1.12.1",
        "pouchdb-find": "^9.0.0"
    },
    "devDependencies": {
        "@sap-ux/ui5-middleware-fe-mockserver": "2",
        "@sap/ux-ui5-tooling": "1",
        "@ui5/cli": "^4.0.38",
        "cordova": "^12.0.0",
        "cordova-android": "^12.0.0",
        "cordova-plugin-camera": "^7.0.0",
        "cordova-plugin-device": "^3.0.0",
        "cordova-plugin-file": "^8.0.0",
        "cordova-plugin-network-information": "^3.0.0",
        "cordova-plugin-splashscreen": "^6.0.2",
        "cordova-plugin-statusbar": "^4.0.0",
        "cordova-plugin-whitelist": "^1.3.5",
        "cpy-cli": "^4.2.0",
        "rimraf": "^3.0.2",
        "ui5-task-flatten-library": "0.2.5"
    },
    "scripts": {
        "start": "fiori run --open \"test/flpSandbox.html?sap-client=100&sap-ui-xx-viewCache=false#comfinancorsdshoppingapp-display\"",
        "start-local": "fiori run --config ./ui5-local.yaml --open \"test/flpSandbox.html?sap-client=100&sap-ui-xx-viewCache=false#comfinancorsdshoppingapp-display\"",
        "build": "ui5 build --config=ui5.yaml --clean-dest --dest dist",
        "build:cordova": "ui5 build --config=ui5-local.yaml --clean-dest --dest dist",
        "deploy": "npm run build && fiori deploy --config ui5-deploy.yaml && rimraf archive.zip",
        "deploy-config": "fiori add deploy-config",
        "start-noflp": "fiori run --open \"index.html?sap-client=100&sap-ui-xx-viewCache=false\"",
        "start-noflp-mock": "fiori run --open \"index.html?sap-ui-xx-viewCache=false&useMockData=true\"",
        "start-mock": "fiori run --config ./ui5-mock.yaml --open \"test/flpSandbox.html?sap-client=100&sap-ui-xx-viewCache=false#comfinancorsdshoppingapp-display\"",
        "start-variants-management": "fiori run --open \"preview.html?&sap-client=100&sap-ui-xx-viewCache=false&fiori-tools-rta-mode=true&sap-ui-rta-skip-flex-validation=true#preview-app\"",
        "unit-tests": "fiori run --config ./ui5-mock.yaml --open 'test/unit/unitTests.qunit.html'",
        "int-tests": "fiori run --config ./ui5-mock.yaml --open 'test/integration/opaTests.qunit.html'",
        "undeploy": "fiori undeploy --config ui5-deploy.yaml",
        "deploy-test": "npm run build && fiori deploy --config ui5-deploy.yaml --testMode true",
        "cordova:prepare": "npm run build:cordova && npx cpy-cli \"dist/**\" www/",
        "cordova:build:android": "npm run cordova:prepare && cordova build android",
        "cordova:build:release": "npm run cordova:prepare && cordova build android --release",
        "cordova:run": "npm run cordova:prepare && cordova run android",
        "cordova:emulate": "npm run cordova:prepare && cordova emulate android",
        "apk:debug": "npm run cordova:build:android",
        "apk:release": "npm run cordova:build:release"
    },
    "sapuxLayer": "CUSTOMER_BASE",
    "ui5": {
        "dependencies": [
            "ui5-task-flatten-library"
        ]
    },
    "cordova": {
        "platforms": [
            "android"
        ],
        "plugins": {
            "cordova-plugin-camera": {
                "ANDROIDX_CORE_VERSION": "1.6.+"
            },
            "cordova-plugin-file": {
                "ANDROIDX_CORE_VERSION": "1.6.+",
                "ANDROIDX_WEBKIT_VERSION": "1.4.0"
            },
            "cordova-plugin-whitelist": {
                "ANDROIDX_CORE_VERSION": "1.6.+",
                "ANDROIDX_WEBKIT_VERSION": "1.4.0"
            },
            "cordova-plugin-network-information": {
                "ANDROIDX_CORE_VERSION": "1.6.+",
                "ANDROIDX_WEBKIT_VERSION": "1.4.0"
            },
            "cordova-plugin-statusbar": {
                "ANDROIDX_CORE_VERSION": "1.6.+",
                "ANDROIDX_WEBKIT_VERSION": "1.4.0"
            },
            "cordova-plugin-splashscreen": {
                "ANDROIDX_CORE_VERSION": "1.6.+",
                "ANDROIDX_WEBKIT_VERSION": "1.4.0"
            },
            "cordova-plugin-device": {
                "ANDROIDX_CORE_VERSION": "1.6.+",
                "ANDROIDX_WEBKIT_VERSION": "1.4.0"
            }
        }
    }
}