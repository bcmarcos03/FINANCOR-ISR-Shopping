<?xml version='1.0' encoding='utf-8'?>
<widget
    id="com.financor.sd.shoppingapp"
    version="0.0.1"
    xmlns="http://www.w3.org/ns/widgets"
    xmlns:cdv="http://cordova.apache.org/ns/1.0"
    xmlns:android="http://schemas.android.com/apk/res/android">

    <name>Shopping App</name>
    <description>
        Financor Shopping Competitor Price Collection Application
    </description>
    <author email="dev@financor.com" href="https://financor.com">
        Financor Development Team
    </author>

    <!-- Entry point for Cordova -->
    <content src="index.html" />

    <!-- Allow all navigation (adjust for production) -->
    <allow-navigation href="*" />
    <allow-intent href="http://*/*" />
    <allow-intent href="https://*/*" />
    <allow-intent href="tel:*" />
    <allow-intent href="sms:*" />
    <allow-intent href="mailto:*" />
    <allow-intent href="geo:*" />

    <!-- Android-specific configuration -->
    <platform name="android">
        <!-- Camera feature (plugins handle permissions automatically) -->
        <config-file target="AndroidManifest.xml" parent="/*">
            <uses-feature android:name="android.hardware.camera" android:required="true" />
            <uses-feature android:name="android.hardware.camera.autofocus" android:required="false" />
        </config-file>

        <!-- Allow cleartext (HTTP) traffic for development -->
        <edit-config file="AndroidManifest.xml" target="/manifest/application" mode="merge">
            <application android:usesCleartextTraffic="true" />
        </edit-config>

        <!-- Allow all URLs for OData service access -->
        <allow-intent href="market:*" />

        <!-- Android build configuration -->
        <preference name="android-minSdkVersion" value="24" />
        <preference name="android-targetSdkVersion" value="33" />
        <preference name="android-compileSdkVersion" value="33" />

        <!-- Gradle configuration -->
        <preference name="GradleVersion" value="7.6" />
        <preference name="AndroidXEnabled" value="true" />

        <!-- Icon configuration (will use defaults until custom icons are added) -->
        <!-- Uncomment when res/android/ icons are created
        <icon src="res/android/ldpi.png" density="ldpi" />
        <icon src="res/android/mdpi.png" density="mdpi" />
        <icon src="res/android/hdpi.png" density="hdpi" />
        <icon src="res/android/xhdpi.png" density="xhdpi" />
        <icon src="res/android/xxhdpi.png" density="xxhdpi" />
        <icon src="res/android/xxxhdpi.png" density="xxxhdpi" />
        -->

        <!-- Splash screen configuration (will use defaults until custom splash screens are added) -->
        <!-- Uncomment when res/android/ splash screens are created
        <splash src="res/android/splash-land-ldpi.png" density="land-ldpi" />
        <splash src="res/android/splash-land-mdpi.png" density="land-mdpi" />
        <splash src="res/android/splash-land-hdpi.png" density="land-hdpi" />
        <splash src="res/android/splash-land-xhdpi.png" density="land-xhdpi" />
        <splash src="res/android/splash-port-ldpi.png" density="port-ldpi" />
        <splash src="res/android/splash-port-mdpi.png" density="port-mdpi" />
        <splash src="res/android/splash-port-hdpi.png" density="port-hdpi" />
        <splash src="res/android/splash-port-xhdpi.png" density="port-xhdpi" />
        -->
    </platform>

    <!-- General Preferences -->
    <preference name="Orientation" value="portrait" />
    <preference name="Fullscreen" value="false" />
    <preference name="StatusBarOverlaysWebView" value="false" />
    <preference name="StatusBarBackgroundColor" value="#0070F2" />
    <preference name="StatusBarStyle" value="lightcontent" />

    <!-- Disable backups for security (adjust as needed) -->
    <preference name="android-allowBackup" value="false" />

    <!-- WebView preferences -->
    <preference name="DisallowOverscroll" value="true" />
    <preference name="BackgroundColor" value="#FFFFFF" />
    <preference name="HideKeyboardFormAccessoryBar" value="false" />
    <preference name="KeyboardDisplayRequiresUserAction" value="false" />

    <!-- Persistent file location -->
    <preference name="AndroidPersistentFileLocation" value="Internal" />

    <!-- Network access -->
    <access origin="*" />
    <access origin="http://192.168.40.171:8000" />
    <access origin="http://*" launch-external="false" />
    <access origin="https://*" launch-external="false" />

    <!-- Content Security Policy -->
    <allow-navigation href="http://*" />
    <allow-navigation href="https://*" />
    <allow-navigation href="http://192.168.40.171:8000/*" />

    <!-- Allow insecure content (HTTP) for development -->
    <allow-intent href="http://*" />
    <allow-intent href="https://*" />
</widget>
